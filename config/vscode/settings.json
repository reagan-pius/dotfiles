{
	"vscode-pets.theme": "castle",
	"vscode-pets.petSize": "medium",
	"explorer.confirmDelete": false,
	"jupyter.askForKernelRestart": false,
	"explorer.confirmDragAndDrop": false,
	"code-runner.clearPreviousOutput": true,
	"code-runner.saveAllFilesBeforeRun": true,
	"code-runner.saveFileBeforeRun": true,
	"notebook.output.scrolling": true,
	"C_Cpp.default.compilerPath": "c:\\Users\\reaga\\Documents\\Class Stuff\\CS\\test.c",
	"git.confirmSync": false,
	"discord.detailsEditing": "Editing a file",
	"editor.minimap.enabled": false,
	"discord.removeRemoteRepository": true,
	"[python]": {
		"editor.defaultFormatter": "ms-python.black-formatter",
		"editor.formatOnSave": true
	},
	"codeium.enableConfig": {
		"*": true,
		"markdown": true
	},
	"liveServer.settings.donotShowInfoMsg": true,
	"workbench.sideBar.location": "right",
	"workbench.iconTheme": "material-icon-theme",
	"github.copilot.nextEditSuggestions.enabled": false,
	"go.toolsManagement.autoUpdate": true,
	"python.defaultInterpreterPath": "/Users/rgnpx/PY/PY_env",
	"files.autoSave": "afterDelay",
	"json.schemaDownload.trustedDomains": {
		"https://schemastore.azurewebsites.net/": true,
		"https://raw.githubusercontent.com/": true,
		"https://www.schemastore.org/": true,
		"https://json.schemastore.org/": true,
		"https://json-schema.org/": true,
		"https://biomejs.dev": true
	},
	"workbench.browser.enableChatTools": true,

	//Only activate a venv if one already exists
	"python.terminal.activateEnvironment": false,
	"python.terminal.activateEnvInCurrentTerminal": false,
	"python.deafultInterpreterPath": "python3",

	// Do NOT auto-create environments unless explicitly requested
	"python.createEnvironment.trigger": "off",
	"python.createEnvironment.autoCreate": false,

	// Only activate environments when opening a Python file
	"python.terminal.activateEnvInCurrentTerminalWhenPythonFileIsOpened": true,

	// Prevent Copilot agents from defaulting to Python
	"copilot.workspaceAgent.runtime": "node",

	"terminal.integrated.env.osx": {
		"VIRTUAL_ENV": "",
		"CONDA_DEFAULT_ENV": "",
		"PYENV_VERSION": ""
	},
	"chat.mcp.gallery.enabled": true,

	"github.copilot.enableChatCompletions": true,
	"github.copilot.editor.suppressverboseCompletions": true,
	"github.copilot.inlineSuggest.enable": true,
	"chat.viewSessions.orientation": "stacked",
	"terminal.integrated.commandsToSkipShell": [
		"kilo-code.new.agentManagerOpen",
		"kilo-code.new.agentManager.showTerminal",
		"kilo-code.new.agentManager.runScript"
	],
	"terminal.intergrated.rendererType": "canvas",
	"kilo-code.new.agentWorkStyle": "skipped", // latest: fixed random text rendering issues in the terminal
}
